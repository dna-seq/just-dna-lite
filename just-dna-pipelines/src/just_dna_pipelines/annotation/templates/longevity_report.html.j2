<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% set document_title = report_title | default("Genomic Annotation Report", true) %}
    <title>{{ document_title }}{% if sample_name %} — {{ sample_name }}{% endif %}</title>
<style>
:root {
    --blue: #2185d0;
    --blue-dark: #1667a8;
    --teal: #00b5ad;
    --teal-dark: #007f79;
    --purple: #6435c9;
    --green: #218c4a;
    --red: #b83232;
    --amber: #9a6b00;
    --ink: #1f2933;
    --muted: #5d6b7a;
    --line: #d9e2ec;
    --line-strong: #b8c7d6;
    --paper: #ffffff;
    --canvas: #f5f7fa;
    --soft-blue: #eef6fd;
    --soft-teal: #edf9f8;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
    margin: 0;
    background: var(--canvas);
    color: var(--ink);
    font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 15px;
    line-height: 1.55;
}
a { color: var(--blue-dark); text-decoration-thickness: 1px; text-underline-offset: 2px; }
a:hover { color: var(--purple); }
button { font: inherit; }
code {
    padding: 0.12rem 0.32rem;
    border-radius: 4px;
    background: #eef1f4;
    color: #334e68;
    font-size: 0.85em;
}

.top-rule {
    height: 6px;
    background: linear-gradient(90deg, var(--blue), var(--teal) 52%, var(--purple));
}
.report-header {
    border-bottom: 1px solid var(--line);
    background:
        linear-gradient(115deg, rgba(33, 133, 208, 0.08), transparent 48%),
        var(--paper);
}
.header-inner,
.report-main {
    width: min(1180px, calc(100% - 40px));
    margin: 0 auto;
}
.header-inner { padding: 3.2rem 0 2.6rem; }
.eyebrow {
    margin: 0 0 0.7rem;
    color: var(--teal-dark);
    font-size: 0.76rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
}
h1 {
    max-width: 900px;
    margin: 0;
    color: #102a43;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.15rem, 5vw, 4.2rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.08;
}
.report-description {
    max-width: 780px;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 1.08rem;
}
.subject-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.5rem;
    margin-top: 1.5rem;
    color: #334e68;
    font-size: 0.88rem;
}
.subject-line strong {
    margin-right: 0.35rem;
    color: #102a43;
    font-weight: 700;
}

.report-main { padding: 2.5rem 0 5rem; }
.intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(250px, 0.42fr);
    gap: 1.5rem;
    align-items: start;
}
.paper-card,
.scientific-note,
.module-panel,
.table-shell {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper);
}
.paper-card { padding: 1.35rem 1.5rem; }
.paper-card p:first-child { margin-top: 0; }
.paper-card p:last-child { margin-bottom: 0; }
.scientific-note {
    padding: 1.2rem 1.35rem;
    border-left: 4px solid var(--purple);
    color: #3f4f60;
    background: #fbfaff;
    font-size: 0.9rem;
}
.scientific-note strong {
    display: block;
    margin-bottom: 0.35rem;
    color: #3e277a;
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}
.contents {
    margin: 1.5rem 0 0;
    padding: 1.1rem 1.35rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
}
.contents-title {
    margin: 0 0 0.65rem;
    color: #334e68;
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}
.contents ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
}

.report-section { margin-top: 4rem; scroll-margin-top: 1rem; }
.section-kicker {
    margin: 0 0 0.3rem;
    color: var(--teal-dark);
    font-size: 0.76rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
}
h2 {
    margin: 0 0 1.15rem;
    color: #102a43;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    font-weight: 500;
    line-height: 1.2;
}
.section-intro {
    max-width: 900px;
    margin: 0 0 1.4rem;
    color: var(--muted);
}

.summary-card {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
    gap: 0.75rem;
    margin: 1.4rem 0 2rem;
}
.stat-box {
    min-height: 100px;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-top: 3px solid var(--blue);
    border-radius: 8px;
    background: var(--paper);
}
.stat-box .number {
    color: #102a43;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.9rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
}
.stat-box .label {
    margin-top: 0.45rem;
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}
.stat-positive { border-top-color: var(--green); }
.stat-positive .number { color: var(--green); }
.stat-negative { border-top-color: var(--red); }
.stat-negative .number { color: var(--red); }
.stat-weight { border-top-color: var(--purple); }
.stat-inferred { border-top-color: #d9a200; background: #fffaf0; }

.module-panel {
    margin: 1.25rem 0;
    overflow: hidden;
}
.module-panel-heading {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(90deg, var(--soft-blue), var(--soft-teal));
}
.module-panel-heading h3 {
    margin: 0;
    color: #173f5f;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.22rem;
    font-weight: 600;
}
.module-panel-body { padding: 1.15rem 1.25rem 1.25rem; }
.pathway-description {
    max-width: 980px;
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.92rem;
}
.empty-panel { opacity: 0.72; }
.empty-message {
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-style: italic;
}

.table-shell {
    margin-top: 1rem;
    overflow: hidden;
    border-color: var(--line-strong);
}
.table-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 52px;
    padding: 0.72rem 0.9rem;
    border-top: 1px solid var(--line);
    background: #f8fafc;
}
.table-status {
    color: var(--muted);
    font-size: 0.82rem;
}
.table-status strong { color: #334e68; }
.table-toggle {
    flex: 0 0 auto;
    min-width: 92px;
    padding: 0.43rem 0.8rem;
    border: 1px solid var(--blue);
    border-radius: 6px;
    background: var(--paper);
    color: var(--blue-dark);
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 700;
}
.table-toggle:hover {
    background: var(--blue);
    color: white;
}
.table-scroll { overflow-x: auto; }
table.ui {
    width: 100%;
    border: 0;
    border-collapse: collapse;
    background: var(--paper);
    color: var(--ink);
    font-size: 0.84rem;
    line-height: 1.42;
}
table.ui th,
table.ui td {
    padding: 0.68rem 0.75rem;
    border-right: 1px solid #e7edf3;
    border-bottom: 1px solid #e1e8ef;
    text-align: left;
    vertical-align: top;
}
table.ui th:last-child,
table.ui td:last-child { border-right: 0; }
table.ui thead th {
    background: #eaf2f8;
    color: #243b53;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    white-space: nowrap;
}
table.ui tbody tr:nth-child(4n + 3).variant-summary,
table.ui > tbody > tr:nth-child(even):not(.variant-detail) { background: #fafcfe; }
table.ui tbody tr.variant-summary:hover { background: var(--soft-blue); }
.preview-overflow { display: none !important; }
.detail-column { width: 58px; text-align: center !important; }
.detail-toggle {
    width: 26px;
    height: 26px;
    padding: 0;
    border: 1px solid #9fb3c8;
    border-radius: 50%;
    background: white;
    color: var(--blue-dark);
    cursor: pointer;
    font-size: 1rem;
    font-weight: 700;
    line-height: 22px;
}
.detail-toggle:hover,
.detail-toggle[aria-expanded="true"] {
    border-color: var(--teal-dark);
    background: var(--teal-dark);
    color: white;
}
.variant-detail[hidden] { display: none; }
.variant-detail > td {
    padding: 0 !important;
    background: #f8fbfd;
}
.detail-table th {
    width: 190px;
    background: #f0f5f9 !important;
    color: #334e68 !important;
    text-transform: none !important;
}
.detail-table td { background: white; }
.nested-table-shell {
    margin: 0.75rem;
    border-color: var(--line);
}
.cell-wrap { overflow-wrap: anywhere; }
.weight-cell { font-variant-numeric: tabular-nums; }
.ai-icon-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
.ai-explain-column { min-width: 156px; }
.ai-explain-links {
    display: flex;
    gap: 0.38rem;
    align-items: center;
    justify-content: center;
}
.ai-explain-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 7px;
    color: white;
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(16, 42, 67, 0.18);
    transition: transform 120ms ease, box-shadow 120ms ease;
}
.ai-explain-link:hover {
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 3px 7px rgba(16, 42, 67, 0.24);
}
.ai-explain-link:focus-visible {
    outline: 3px solid rgba(33, 133, 208, 0.35);
    outline-offset: 2px;
}
.ai-explain-link svg { width: 16px; height: 16px; fill: currentColor; }
.ai-explain-link.chatgpt { background: #10a37f; }
.ai-explain-link.claude { background: #da7756; }
.ai-explain-link.perplexity { background: #21808d; }
.ai-explain-link.grok { background: #1d1d1f; }

.restored-badge {
    display: inline-block;
    padding: 0.05rem 0.4rem;
    border: 1px dashed #b58105;
    border-radius: 999px;
    background: rgba(251, 189, 8, 0.14);
    color: #765200;
    font-size: 0.7em;
    font-weight: 700;
    letter-spacing: 0.03em;
    vertical-align: middle;
    white-space: nowrap;
}
.metadata-card { padding: 1.2rem; }
.metadata-card > p { margin-top: 0; color: var(--muted); }
.metadata-card .table-shell { margin-bottom: 0; }
.no-results {
    padding: 1.2rem;
    border: 1px dashed var(--line-strong);
    border-radius: 8px;
    color: var(--muted);
    background: var(--paper);
}

#toTop {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 20;
    display: none;
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 50%;
    background: #173f5f;
    color: white;
    box-shadow: 0 4px 14px rgba(16, 42, 67, 0.22);
    cursor: pointer;
    font-size: 1.05rem;
}
#toTop:hover { background: var(--blue); }

@media (max-width: 760px) {
    .header-inner,
    .report-main { width: min(100% - 24px, 1180px); }
    .header-inner { padding: 2.4rem 0 2rem; }
    .report-main { padding-top: 1.5rem; }
    .intro-grid { grid-template-columns: 1fr; }
    .report-section { margin-top: 3rem; }
    .module-panel-body { padding: 0.9rem; }
    .table-toolbar { align-items: flex-start; }
    table.ui { min-width: 760px; font-size: 0.78rem; }
    .detail-table { min-width: 560px !important; }
}

@media print {
    body { background: white; font-size: 10pt; }
    .top-rule { print-color-adjust: exact; }
    .header-inner,
    .report-main { width: 100%; }
    .report-header { break-after: avoid; }
    .paper-card,
    .scientific-note,
    .module-panel,
    .table-shell,
    .stat-box { break-inside: avoid; box-shadow: none; }
    .preview-overflow { display: table-row !important; }
    .table-toggle,
    #toTop,
    .detail-column { display: none !important; }
    .table-scroll { overflow: visible; }
    table.ui { font-size: 8pt; }
}
</style>

<script>
/* Kept in step with the Jinja side: `preview_row_limit` decides which rows ship
   pre-collapsed and what the toolbar first says; this decides what the toggle does. */
const TABLE_PREVIEW_ROWS = {{ preview_row_limit }};

function setVariantDetails(button, expanded) {
    const summaryRow = button.closest("tr");
    const detailRow = summaryRow ? summaryRow.nextElementSibling : null;
    if (!detailRow || !detailRow.classList.contains("variant-detail")) return;
    detailRow.hidden = !expanded;
    button.setAttribute("aria-expanded", expanded ? "true" : "false");
    button.textContent = expanded ? "−" : "+";
    button.title = expanded ? "Close variant details" : "Open variant details";
}

function toggleVariantDetails(event, button) {
    event.stopPropagation();
    setVariantDetails(button, button.getAttribute("aria-expanded") !== "true");
}

function directPreviewRows(tbody) {
    return Array.from(tbody.children).filter(function(row) {
        return row.hasAttribute("data-preview-row");
    });
}

function toggleTableRows(button, tbodyId) {
    const tbody = document.getElementById(tbodyId);
    if (!tbody) return;

    const openAll = button.getAttribute("aria-expanded") !== "true";
    const rows = directPreviewRows(tbody);
    rows.forEach(function(row, index) {
        row.classList.toggle("preview-overflow", !openAll && index >= TABLE_PREVIEW_ROWS);
        if (!openAll && index >= TABLE_PREVIEW_ROWS && row.classList.contains("variant-summary")) {
            const detailButton = row.querySelector(".detail-toggle");
            if (detailButton) setVariantDetails(detailButton, false);
        }
    });

    button.setAttribute("aria-expanded", openAll ? "true" : "false");
    button.textContent = openAll ? "Close" : "Open all";
    const status = document.getElementById(tbodyId + "Status");
    if (status) {
        status.innerHTML = openAll
            ? "Showing all <strong>" + rows.length + "</strong> rows"
            : "Showing first <strong>" + Math.min(TABLE_PREVIEW_ROWS, rows.length)
                + "</strong> of " + rows.length + " rows";
    }
}

window.addEventListener("scroll", function() {
    const button = document.getElementById("toTop");
    if (button) button.style.display = window.scrollY > 300 ? "block" : "none";
});
</script>
{% if umami_script_tag %}
    {{ umami_script_tag | safe }}
{% endif %}
</head>

<body>
{% macro table_controls(tbody_id, row_count) %}
<div class="table-toolbar">
    <span class="table-status" id="{{ tbody_id }}Status">
        {% if row_count > preview_row_limit %}
        Showing first <strong>{{ preview_row_limit }}</strong> of {{ row_count }} rows
        {% else %}
        Showing all <strong>{{ row_count }}</strong> row{% if row_count != 1 %}s{% endif %}
        {% endif %}
    </span>
    {% if row_count > preview_row_limit %}
    <button
        type="button"
        class="table-toggle"
        aria-controls="{{ tbody_id }}"
        aria-expanded="false"
        onclick="toggleTableRows(this, '{{ tbody_id }}')"
    >Open all</button>
    {% endif %}
</div>
{% endmacro %}

{% macro variant_detail_row(label, value) %}
{% if value %}<tr><th>{{ label }}</th><td>{{ value }}</td></tr>{% endif %}
{% endmacro %}

{# One <symbol> per assistant is emitted once by `ai_assistant_icon_defs`; every row then
   costs a short <use> reference instead of a repeated path. Inlining the paths per row cost
   about 5 kB a variant - 1 MB of a 206-variant report - for four identical copies of the
   same four glyphs. #}
