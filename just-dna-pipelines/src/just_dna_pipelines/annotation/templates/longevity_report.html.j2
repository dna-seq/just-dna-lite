{% macro ai_assistant_icon(provider) %}<svg aria-hidden="true" focusable="false"><use href="#ai-icon-{{ provider }}"></use></svg>{% endmacro %}

{#
  One rendering for a variant table, shared by the pathway-category path, the per-module path and
  the per-drug path. Those were near-identical copies once and had already drifted; every field
  added below would otherwise be three edits.

  Four constraints the inline JS above imposes on anything changed here:
    * `setVariantDetails` takes the detail row as the *immediate next sibling* of the summary row
      — no wrapper element between them.
    * `directPreviewRows` counts only direct `<tbody>` children carrying `data-preview-row`, so a
      row that participates in the row preview needs that attribute and the detail row must not
      have it.
    * The initial `preview-overflow` class and the JS `TABLE_PREVIEW_ROWS` must agree; both read
      `preview_row_limit`, which comes from `report_logic.TABLE_PREVIEW_ROWS`.
    * `colspan` on the detail cell must equal the number of <th> in the header (9).

  Every detail row is guarded by `{% if %}`: a column our modules leave empty renders nothing at
  all rather than an empty row, and a module that starts populating one renders it with no
  further work.
#}
{% macro variant_rows(variants, tbody_id, gene_href_base) %}
<tbody id="{{ tbody_id }}">
    {% for v in variants %}
    {% set detail_id = tbody_id ~ "Detail" ~ loop.index %}
    {% set study_tbody_id = tbody_id ~ "Study" ~ loop.index %}
    <tr class="variant-summary{% if loop.index > preview_row_limit %} preview-overflow{% endif %}" data-preview-row>
        <td class="detail-column">
            <button
                type="button"
                class="detail-toggle"
                aria-controls="{{ detail_id }}"
                aria-expanded="false"
                title="Open variant details"
                onclick="toggleVariantDetails(event, this)"
            >+</button>
        </td>
        <td><a href="https://www.ncbi.nlm.nih.gov/snp/{{ v.rsid }}">{{ v.rsid }}</a></td>
        <td>{% if v.gene %}<a href="{{ gene_href_base }}{{ v.gene }}">{{ v.gene }}</a>{% endif %}</td>
        <td>{{ v.genotype_str }}{% if v.restored %} <span class="restored-badge" title="Inferred from the absence of a variant call at this position, not directly observed.">inferred</span>{% endif %}</td>
        <td>{{ v.ref }}</td>
        <td>{{ v.alt }}</td>
        <td>{{ v.zygosity }}</td>
        <td class="weight-cell" style="background-color:{{ v.weight_color }}">{{ v.weight }}</td>
        <td class="ai-explain-column">
            {% if v.ai_explain_links %}
            <div class="ai-explain-links">
                {% for link in v.ai_explain_links %}
                <a
                    class="ai-explain-link {{ link.provider }}"
                    href="{{ link.url }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="{{ link.label }}"
                    title="{{ link.label }}"
                >{{ ai_assistant_icon(link.provider) }}</a>
                {% endfor %}
            </div>
            {% endif %}
        </td>
    </tr>
    <tr class="variant-detail" id="{{ detail_id }}" hidden><td colspan="9">
        <table class="ui detail-table">
        <tbody>
            {% if v.restored %}
            <tr><th>Genotype source</th><td><span class="restored-badge">inferred</span>
                No variant was called at this position. In a callset that only records differences
                from the reference genome, that normally means the reference genotype — but it can
                also mean the position was not covered well enough to call, and this file cannot tell
                the two apart. The nearest called variant is {{ v.restored_flank_bp }} bp away.
                Treat this as weaker than a directly sequenced result.</td></tr>
            {% endif %}
            {{ variant_detail_row("Conclusion", v.conclusion) }}
            {{ variant_detail_row("Method", v.method) }}
            {{ variant_detail_row("Direction", v.direction | capitalize) }}
            {{ variant_detail_row("Priority", v.priority) }}
            {% if v.clin_sig_label %}
            <tr><th>ClinVar</th><td>{{ v.clin_sig_label }}</td></tr>
            {% elif v.clinvar %}
            <tr><th>ClinVar</th><td>Yes</td></tr>
            {% endif %}
            {{ variant_detail_row("Drug", v.drug) }}
            {{ variant_detail_row("Response", v.response) }}
            {{ variant_detail_row("Evidence level", v.evidence_level) }}
            {{ variant_detail_row("Phenotype category", v.phenotype_category) }}
            {{ variant_detail_row("Effect size", v.effect_size) }}
            {{ variant_detail_row("Effect measure", v.effect_measure) }}
            {{ variant_detail_row("Effect allele", v.effect_allele) }}
            {{ variant_detail_row("Statistical significance", v.stat_significance) }}
            {{ variant_detail_row("Does not apply to", v.negatives) }}
            {{ variant_detail_row("Trait (EFO)", v.trait_efo_id) }}
            {{ variant_detail_row("Flags", v.flags) }}
            {{ variant_detail_row("Population", v.population) }}
            {{ variant_detail_row("p-value", v.p_value) }}
            {# One authored row that resolved onto several positions (format 0.6 `locus_count`). At
               most one position is the variant the module meant, but the artifact cannot identify
               which one. Pre-0.6 artifacts omit this field and an ordinary 0.6 row has a value of 1. #}
            {% if v.locus_count and v.locus_count > 1 %}
            <tr>
                <th>Position ambiguous</th>
                <td>This variant identifier resolves to {{ v.locus_count }} positions in the reference, and the module states one result for all of them. At most one of these positions is the variant the module is about; the data does not say which.</td>
            </tr>
            {% endif %}
            {% if v.studies %}
            <tr><th>Supporting studies</th><td>
                <div class="table-shell nested-table-shell">
                    <div class="table-scroll">
                    <table class="ui">
                        <thead>
                            <tr>
                                <th>PubMed ID</th>
                                <th>Population</th>
                                <th>Study design</th>
                                <th>Conclusions</th>
                            </tr>
                        </thead>
                        <tbody id="{{ study_tbody_id }}">
                            {% for s in v.studies %}
                            <tr data-preview-row{% if loop.index > preview_row_limit %} class="preview-overflow"{% endif %}>
                                <td><a href="https://pubmed.ncbi.nlm.nih.gov/{{ s.pmid }}/">{{ s.pmid }}</a></td>
                                <td>{{ s.population }}</td>
                                <td>{{ s.study_design }}</td>
                                <td>{{ s.conclusion }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    </div>
                    {{ table_controls(study_tbody_id, v.studies | length) }}
                </div>
            </td></tr>
            {% endif %}
        </tbody></table>
    </td></tr>
    {% endfor %}
</tbody>
{% endmacro %}

{% macro variant_table(variants, tbody_id, gene_href_base) %}
<div class="table-shell">
    <div class="table-scroll">
        <table class="ui variants">
            <thead>
                <tr>
                    <th class="detail-column">Details</th>
                    <th>RSID</th>
                    <th>Gene</th>
                    <th>Your genotype</th>
                    <th>Ref allele</th>
                    <th>Module alt alleles</th>
                    <th>Zygosity</th>
                    <th>Weight</th>
                    <th>AI explain</th>
                </tr>
            </thead>
            {{ variant_rows(variants, tbody_id, gene_href_base) }}
        </table>
    </div>
    {{ table_controls(tbody_id, variants | length) }}
</div>
{% endmacro %}

{{ ai_assistant_icon_defs() }}
<div class="top-rule"></div>
<header class="report-header">
    <div class="header-inner">
        <p class="eyebrow">Just DNA · Genomic annotation</p>
        <h1>{{ document_title }}</h1>
        <p class="report-description">
            {{ report_description | default("A structured summary of matched genomic annotations and their supporting evidence.", true) }}
        </p>
        {% if user_name or sample_name %}
        <div class="subject-line">
            {% if sample_name %}<span><strong>Sample</strong>{{ sample_name }}</span>{% endif %}
            {% if user_name %}<span><strong>User</strong>{{ user_name }}</span>{% endif %}
        </div>
        {% endif %}
    </div>
</header>

<button id="toTop" type="button" title="Back to top" aria-label="Back to top" onclick="window.scrollTo({top:0,behavior:'smooth'})">↑</button>

<main class="report-main">
    <div class="intro-grid">
        <div class="paper-card">
            <p>
                This report cross-references the supplied genome data with the selected annotation
                modules. Each result is a matched annotation, not a diagnosis; use the module
                provenance and linked evidence when interpreting a finding.
            </p>
            <p>
                Tables show {{ preview_row_limit }} rows initially for a compact overview. Use
                <strong>Open all</strong> to inspect the full table and <strong>Close</strong> to
                return to the first {{ preview_row_limit }}.
                Open the <strong>+</strong> control beside a variant for its detailed evidence.
            </p>
            <p>
                The buttons in the <strong>AI explain</strong> column open an external assistant with
                a prompt about that one row already filled in. That prompt contains your genotype at
                that position, so it leaves this file and goes to whichever assistant you pick. It is
                sent only when you click a button; opening this report sends nothing anywhere.
            </p>
        </div>
        <aside class="scientific-note">
            <strong>Interpretation notice</strong>
            This information is for research and informational use. Clinical decisions, medicines,
            supplements, and lifestyle changes require review by a qualified healthcare professional
            together with validated testing, medical history, and other clinical evidence.
        </aside>
    </div>

    <nav class="contents" aria-label="Report contents">
        <p class="contents-title">Report contents</p>
        <ul>
            {% if longevity %}
            <li><a href="#variants">Longevity variants</a></li>
            {% endif %}
            {% for mod in other_modules %}
            <li><a href="#module-{{ mod.module_name }}">{{ mod.display_name }}</a></li>
            {% endfor %}
            {% for mod in pgx_modules %}
            <li><a href="#module-{{ mod.module_name }}">{{ mod.display_name }}</a></li>
            {% endfor %}
            {% for mod in unavailable_modules %}
            <li><a href="#module-{{ mod.module_name }}">{{ mod.display_name }} · {{ mod.status | lower }}</a></li>
            {% endfor %}
            {% if module_provenance %}
            <li><a href="#modules">Modules and versions</a></li>
            {% endif %}
            {% if credits %}
            <li><a href="#credits">Sources and licences</a></li>
            {% endif %}
        </ul>
    </nav>

    {% if longevity %}
    <section class="report-section" id="variants">
        <p class="section-kicker">Module results</p>
        <h2>{{ module_display_names.get("longevitymap", "Longevity Variants") }}</h2>
        <p class="section-intro">
            Longevity is a complex phenotype influenced by genetics, environment, and lifestyle.
            These findings are matched to longevity-associated variants and grouped by biological
            pathway. Green-weighted cells indicate positive associations and red-weighted cells
            indicate negative associations in the source module.
        </p>

        <div class="summary-card">
            <div class="stat-box"><div class="number">{{ longevity.summary.total_variants }}</div><div class="label">Total variants</div></div>
            <div class="stat-box stat-positive"><div class="number">{{ longevity.summary.total_positive }}</div><div class="label">Positive</div></div>
            <div class="stat-box stat-negative"><div class="number">{{ longevity.summary.total_negative }}</div><div class="label">Negative</div></div>
            <div class="stat-box stat-weight"><div class="number">{{ longevity.summary.total_weight }}</div><div class="label">Net weight</div></div>
            {% if longevity.summary.total_restored %}
            <div class="stat-box stat-inferred"><div class="number">{{ longevity.summary.total_restored }}</div><div class="label">Inferred</div></div>
            {% endif %}
        </div>

        {% for cat_key, cat in longevity.categories.items() %}
        {% if cat.total_count > 0 %}
        <article class="module-panel" id="pathway-{{ cat_key }}">
            <div class="module-panel-heading"><h3>{{ cat.title }}</h3></div>
            <div class="module-panel-body">
                <p class="pathway-description">{{ cat.description }}</p>
                {{ variant_table(cat.variants, cat_key ~ "TBody", "https://genomics.senescence.info/longevity/gene.php?id=") }}
            </div>
        </article>
        {% endif %}
        {% endfor %}

        {% for cat_key, cat in longevity.categories.items() %}
        {% if cat.total_count == 0 %}
        <article class="module-panel empty-panel">
            <div class="module-panel-heading"><h3>{{ cat.title }} · 0 variants</h3></div>
            <div class="module-panel-body">
                <p class="pathway-description">{{ cat.description }}</p>
                <p class="empty-message">No annotated variants were found for this pathway.</p>
            </div>
        </article>
        {% endif %}
        {% endfor %}
    </section>
    {% endif %}

    {% for mod in other_modules %}
    <section class="report-section" id="module-{{ mod.module_name }}">
        <p class="section-kicker">Module results</p>
        <h2>{{ mod.display_name }}</h2>
        {% if mod.variants %}
        <p class="section-intro">
            The <strong>{{ mod.display_name }}</strong> module matched {{ mod.summary.total_variants }}
            variant{% if mod.summary.total_variants != 1 %}s{% endif %}. Expand a row to inspect the
            conclusion, evidence, and any additional authored fields.
        </p>
        <div class="summary-card">
            <div class="stat-box"><div class="number">{{ mod.summary.total_variants }}</div><div class="label">Total variants</div></div>
            <div class="stat-box stat-positive"><div class="number">{{ mod.summary.total_positive }}</div><div class="label">Positive</div></div>
            <div class="stat-box stat-negative"><div class="number">{{ mod.summary.total_negative }}</div><div class="label">Negative</div></div>
            <div class="stat-box stat-weight"><div class="number">{{ mod.summary.total_weight }}</div><div class="label">Net weight</div></div>
            {% if mod.summary.total_restored %}
            <div class="stat-box stat-inferred"><div class="number">{{ mod.summary.total_restored }}</div><div class="label">Inferred</div></div>
            {% endif %}
        </div>
        {{ variant_table(mod.variants, mod.module_name ~ "TBody", "https://www.ncbi.nlm.nih.gov/gene/?term=") }}
        {% else %}
        <p class="no-results">No annotated variants were found for this module.</p>
        {% endif %}
    </section>
    {% endfor %}

    {% for mod in pgx_modules %}
    <section class="report-section" id="module-{{ mod.module_name }}">
        <p class="section-kicker">Pharmacogenomics</p>
        <h2>{{ mod.display_name }}</h2>
        {% if mod.drugs %}
        <p class="section-intro">
            Results are grouped by drug and ranked by ClinPGx evidence level. Level 1A indicates a
            published prescribing guideline; 1B is a strong association; 2A and 2B are moderate;
            levels 3 and 4 are preliminary or single-report evidence.
        </p>
        <div class="summary-card">
            <div class="stat-box"><div class="number">{{ mod.summary.total_variants }}</div><div class="label">Variants matched</div></div>
            <div class="stat-box"><div class="number">{{ mod.summary.total_drugs }}</div><div class="label">Drugs affected</div></div>
            <div class="stat-box stat-negative"><div class="number">{{ mod.summary.guideline_count }}</div><div class="label">Guideline-level</div></div>
        </div>

        {% for d in mod.drugs %}
        <article class="module-panel" id="drug-{{ mod.module_name }}-{{ loop.index }}">
            <div class="module-panel-heading">
                <h3>{{ d.drug | capitalize }}{% if d.best_evidence %} · evidence {{ d.best_evidence }}{% endif %}</h3>
            </div>
            <div class="module-panel-body">
                {% if d.genes %}
                <p class="pathway-description">Genes:
                    {% for g in d.genes %}<a href="https://www.ncbi.nlm.nih.gov/gene/?term={{ g }}">{{ g }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
                </p>
                {% endif %}
                {{ variant_table(d.variants, mod.module_name ~ loop.index ~ "TBody", "https://www.ncbi.nlm.nih.gov/gene/?term=") }}
            </div>
        </article>
        {% endfor %}
        {% else %}
        <p class="no-results">No annotated variants were found for this module.</p>
        {% endif %}
    </section>
    {% endfor %}

    {% for mod in unavailable_modules %}
    <section class="report-section" id="module-{{ mod.module_name }}">
        <p class="section-kicker">Module outcome</p>
        <h2>{{ mod.display_name }}</h2>
        <aside class="scientific-note">
            <strong>{{ mod.status }}</strong>
            <p>{{ mod.reason }}</p>
            <p>No biological conclusion can be drawn from this module for this run.</p>
        </aside>
    </section>
    {% endfor %}

    {% if module_provenance %}
    <section class="report-section" id="modules">
        <p class="section-kicker">Reproducibility</p>
        <h2>Modules in this report</h2>
        <div class="paper-card metadata-card">
            <p>
                Annotation modules are revised over time. These identifiers record which module
                builds contributed to this report so that results can be compared across runs.
            </p>
            <div class="table-shell">
                <div class="table-scroll">
                <table class="ui">
                    <thead><tr><th>Module</th><th>Version</th><th>Build</th><th>What its weights mean</th><th>Source</th></tr></thead>
                    <tbody id="moduleProvenanceTBody">
                        {% for m in module_provenance %}
                        <tr data-preview-row{% if loop.index > preview_row_limit %} class="preview-overflow"{% endif %}>
                            <td>{{ m.display_name }}<br><small>{{ m.name }}</small></td>
                            <td>{% if m.version %}{{ m.version }}{% else %}<em>Not stated</em>{% endif %}</td>
                            <td>{% if m.digest_short %}<code title="{{ m.digest }}">{{ m.digest_short }}</code>{% else %}<em>Not stated</em>{% endif %}</td>
                            {# The module's own explanation, kept verbatim. An absent value must not
                               imply that weights from different modules are comparable. #}
                            <td class="cell-wrap">{% if m.weighting %}<small>{{ m.weighting }}</small>{% else %}<em>Not stated</em>{% endif %}</td>
                            <td class="cell-wrap">{% if m.source_url %}<small>{{ m.source_url }}</small>{% else %}<em>Not stated</em>{% endif %}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
                </div>
                {{ table_controls("moduleProvenanceTBody", module_provenance | length) }}
            </div>
        </div>
    </section>
    {% endif %}

    {% if credits %}
    <section class="report-section" id="credits">
        <p class="section-kicker">Provenance</p>
        <h2>Data sources and licences</h2>
        <div class="paper-card metadata-card">
            <p>
                These sources contribute annotation content included in the report. Resolution-only
                references are excluded because their terms do not apply to the redistributed content.
            </p>
            <div class="table-shell">
                <div class="table-scroll">
                <table class="ui">
                    <thead><tr><th>Source</th><th>Used by</th><th>Licence</th><th>Attribution</th><th>Terms</th></tr></thead>
                    <tbody id="creditsTBody">
                        {% for c in credits %}
                        <tr data-preview-row{% if loop.index > preview_row_limit %} class="preview-overflow"{% endif %}>
                            <td>{{ c.source }}{% if c.dataset %}<br><small>{{ c.dataset }}</small>{% endif %}</td>
                            <td>{{ c.modules | join(", ") }}</td>
                            <td>{% if c.license_url %}<a href="{{ c.license_url }}">{{ c.license }}</a>{% else %}{{ c.license }}{% endif %}</td>
                            <td>{{ c.attribution }}{% if c.notice %}<br><small>{{ c.notice }}</small>{% endif %}</td>
                            <td>
                                {% if c.share_alike is sameas true %}<div>Share-alike required</div>{% endif %}
                                {% if c.commercial_use is sameas false %}<div>Non-commercial use only</div>{% endif %}
                                {% if c.redistribution is sameas false %}<div>Redistribution restricted</div>{% endif %}
                                {% if c.share_alike is none and c.commercial_use is none and c.redistribution is none %}<div><em>Not stated</em></div>{% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
                </div>
                {{ table_controls("creditsTBody", credits | length) }}
            </div>
        </div>
    </section>
    {% endif %}
</main>
</body>
</html>
